{
  "name": "eshop-e2e-playwright",
  "version": "1.0.0",
  "description": "End-to-end UI tests for the nopCommerce demo web shop (Playwright + TypeScript, Page Object Model)",
  "private": true,
  "author": "Roman Nazarchuk",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests .github \"*.{ts,mjs,json}\" README.md --ignore-unknown --no-error-on-unmatched-pattern",
    "format:check": "prettier --check src tests .github \"*.{ts,mjs,json}\" README.md --ignore-unknown --no-error-on-unmatched-pattern",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "zod": "^4.6.7"
  }
}
